USE_AZURE_OPENAI=false

# OpenAI mode
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_WEB_MODEL=gpt-4o

# Azure OpenAI mode
# Set USE_AZURE_OPENAI=true to enable Azure OpenAI.
# AZURE_OPENAI_ENDPOINT may be either:
# - a resource/project base URL like https://your-resource.openai.azure.com
# - or a longer URL that already contains /openai/v1 or /responses
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_WEB_DEPLOYMENT=gpt-4o

# Learning / pedagogy profile
CHATBOT_LEARNER_PROFILE=Engineering Student

# LLM enrichment (Silver -> Gold enriched)
LLM_ENRICH_MODEL=gpt-4o
LLM_GOLD_PREFIX=llm_enriched/
LLM_ENRICH_MAX_RECORDS=0
LLM_ENRICH_SKIP_EXISTING=true
LLM_ENRICH_INPUT_CHAR_LIMIT=4500
